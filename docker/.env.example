MAKOSH_POSTGRES_DB=makosh_hub
MAKOSH_POSTGRES_USER=makosh
MAKOSH_POSTGRES_PASSWORD=change-me-local-dev-only
MAKOSH_POSTGRES_BIND=127.0.0.1
MAKOSH_POSTGRES_PORT=30432
MAKOSH_NATS_BIND=127.0.0.1
MAKOSH_NATS_PORT=34222
MAKOSH_NATS_MONITOR_BIND=127.0.0.1
MAKOSH_NATS_MONITOR_PORT=38222
MAKOSH_NATS_SERVER_URL=nats://127.0.0.1:34222
MAKOSH_CLAMAV_BIND=127.0.0.1
MAKOSH_CLAMAV_PORT=33310
MAKOSH_CLAMAV_ADDR=127.0.0.1:33310
MAKOSH_CLAMAV_TIMEOUT_SECONDS=30
# A loopback-only gateway bridges Макошь to the extractor's internal Docker
# network; the parser container itself has no external egress.
MAKOSH_ATTACHMENT_EXTRACTOR_ENABLED=true
MAKOSH_ATTACHMENT_EXTRACTOR_BIND=127.0.0.1
MAKOSH_ATTACHMENT_EXTRACTOR_PORT=8788
MAKOSH_ATTACHMENT_OCR_LANGUAGES=eng+rus
MAKOSH_ATTACHMENT_EXTRACTOR_ADDR=127.0.0.1:8788
MAKOSH_BACKEND_BIND=127.0.0.1
MAKOSH_BACKEND_PORT=8080
MAKOSH_FRONTEND_BIND=127.0.0.1
MAKOSH_FRONTEND_PORT=5174
MAKOSH_LOCAL_API_SECRET=change-me-local-api-secret
MAKOSH_DEV_MODE=true
MAKOSH_HOST_VAULT_HOME=${HOME}/.makosh/vault
MAKOSH_VAULT_HOME=/makosh-vault
MAKOSH_DEV_KEY_PATH=/makosh-vault/dev/master.key
MAKOSH_SECRET_VAULT_KEY=change-me-local-secret-vault-key
# Optional native TDLib JSON runtime path, for example:
# MAKOSH_TDJSON_PATH=/opt/homebrew/lib/libtdjson.dylib
# Optional Telegram app credentials for local TDLib login flows:
# MAKOSH_TELEGRAM_API_ID=123456
# MAKOSH_TELEGRAM_API_HASH=replace-with-telegram-api-hash
# Optional Google OAuth client credentials for one-click Gmail, Calendar and Contacts setup.
# Prefer the downloaded Desktop app JSON path for packaged/local desktop OAuth config:
# MAKOSH_GOOGLE_OAUTH_CLIENT_CONFIG_PATH=/absolute/path/to/client_secret.json
# Or use explicit runtime overrides:
# MAKOSH_GOOGLE_OAUTH_CLIENT_ID=replace-with-google-oauth-client-id
# MAKOSH_GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-oauth-client-secret
MAKOSH_OLLAMA_BASE_URL=http://192.168.1.2:11434
MAKOSH_OLLAMA_CHAT_MODEL=qwen3:4b
MAKOSH_OLLAMA_EMBED_MODEL=qwen3-embedding:4b
MAKOSH_OLLAMA_TIMEOUT_SECONDS=120
