cc_binary(
    name = "libmakosh_tgcalls_bridge.dylib",
    srcs = [
        "bridge.cpp",
        "bridge.h",
    ],
    copts = [
        "-Isubmodules/TgVoipWebrtc/tgcalls/tgcalls",
        "-Ithird-party/webrtc/webrtc",
        "-Ithird-party/webrtc/dependencies",
        "-Ithird-party/webrtc/absl",
        "-Ithird-party/libyuv",
        "-DWEBRTC_MAC",
        "-DWEBRTC_POSIX",
        "-DRTC_ENABLE_VP9",
        "-DTGVOIP_NAMESPACE=tgvoip_webrtc",
        "-std=c++17",
        "-fvisibility=hidden",
    ],
    linkshared = True,
    linkopts = [
        "-framework",
        "ApplicationServices",
        "-framework",
        "AudioToolbox",
        "-framework",
        "CoreAudio",
        "-framework",
        "CoreFoundation",
        "-framework",
        "CoreGraphics",
        "-framework",
        "Foundation",
    ],
    deps = [
        "//submodules/TgVoipWebrtc:tgcalls_core",
        "//third-party/webrtc:makosh_macos_audio_device",
    ],
    visibility = ["//visibility:public"],
)

